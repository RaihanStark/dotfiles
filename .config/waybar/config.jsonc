// Waybar — Suckless / dwm style
{
    "layer": "top",
    "position": "top",
    "height": 25,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/dwm-layout",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "custom/airpods",
        "cpu",
        "temperature",
        "custom/mem",
        "network",
        "custom/bat-volt",
        "clock"
    ],
    "custom/dwm-layout": {
        "format": "[]=",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": false
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 65,
        "separate-outputs": true
    },
    "pulseaudio": {
        "format": "[vol: {volume}%]",
        "format-muted": "[vol: mute]",
        "on-click": "pavucontrol"
    },
    "custom/airpods": {
        "exec": "airpods-tui --waybar-watch",
        "return-type": "json",
        "format": "[pods: {text}]",
        "hide-empty-text": true,
        "on-click": "footclient --app-id=float-term airpods-tui"
    },
    "cpu": {
        "interval": 5,
        "format": "[cpu: {usage}% |",
        "tooltip": false
    },
    "temperature": {
        "interval": 5,
        "thermal-zone": 6,
        "critical-threshold": 85,
        "format": "{temperatureC}°C]",
        "tooltip": false
    },
    "custom/mem": {
        "interval": 5,
        "exec": "awk '/MemTotal/{t=$2} /MemFree/{f=$2} /Buffers/{b=$2} /^Cached/{c=$2} /SReclaimable/{s=$2} END{m=(t-f-b-c-s)/1024; if(m<1024) printf \"[mem: %.0fM]\\n\", m; else printf \"[mem: %.2fG]\\n\", m/1024}' /proc/meminfo",
        "tooltip": false
    },
    "network": {
        "format-wifi": "[wifi: {essid}]",
        "format-ethernet": "[eth: up]",
        "format-disconnected": "[net: down]",
        "on-click": "footclient --app-id=float-term nmtui",
        "tooltip": false
    },
    "battery": {
        "interval": 2,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "[bat: {capacity}% {power:.1f}W]",
        "format-charging": "[bat: +{capacity}% {power:.1f}W]",
        "format-plugged": "[bat: ~{capacity}%]"
    },
    "custom/bat-volt": {
        "interval": 5,
        "exec": "awk 'FILENAME~/voltage_now/{v=$1/1e6} FILENAME~/power_now/{p=$1/1e6} FILENAME~/capacity$/{c=$1} FILENAME~/status/{s=$1} END{sym=(s==\"Charging\"?\"+\":(s==\"Discharging\"?\"\":\"~\")); printf \"[bat: %s%d%% | %.2fV | %.1fW]\\n\", sym, c, v, p}' /sys/class/power_supply/BAT0/voltage_now /sys/class/power_supply/BAT0/power_now /sys/class/power_supply/BAT0/capacity /sys/class/power_supply/BAT0/status",
        "tooltip": false
    },
    "clock": {
        "interval": 30,
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 5
    }
}
