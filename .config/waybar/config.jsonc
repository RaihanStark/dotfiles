// Waybar — Suckless / dwm style
{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/dwm-layout",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "pulseaudio",
        "custom/airpods",
        "network",
        "battery",
        "clock"
    ],
    "custom/dwm-layout": {
        "format": "[]=",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": false
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 55,
        "separate-outputs": true
    },
    "cpu": {
        "format": "[cpu: {usage}%]",
        "interval": 2
    },
    "memory": {
        "format": "[mem: {used:0.1f}G]",
        "interval": 2
    },
    "pulseaudio": {
        "format": "[vol: {volume}%]",
        "format-muted": "[vol: mute]",
        "on-click": "pavucontrol"
    },
    "custom/airpods": {
        "exec": "airpods-tui --waybar-watch",
        "return-type": "json",
        "format": "[pods: {text}]",
        "on-click": "kitty --class float-term airpods-tui"
    },
    "network": {
        "format-wifi": "[wifi: {essid}]",
        "format-ethernet": "[eth: up]",
        "format-disconnected": "[net: down]",
        "tooltip": false
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "[bat: {capacity}%]",
        "format-charging": "[bat: +{capacity}%]",
        "format-plugged": "[bat: ~{capacity}%]"
    },
    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "icon-size": 13,
        "spacing": 4
    }
}
